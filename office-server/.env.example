# คัดลอกเป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ไม่ถูก commit)
PORT=8787

# ฐานข้อมูล MySQL POS
DB_HOST=inventory.dyndns.tv
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ใส่รหัสผ่านตรงนี้

# token กันคนนอก (ถ้าเว้นว่าง = ไม่ตรวจ) — ถ้าตั้ง ต้องใส่ USAGE_API_TOKEN ฝั่ง Vercel ให้ตรงกัน
API_TOKEN=

# ปิด UPnP อัตโนมัติได้โดยตั้งเป็น off (กรณี forward พอร์ตเองที่ router แล้ว)
UPNP=

# แหล่งข้อมูลยอดขาย POS (ถ้าเว้นว่าง = ใช้ค่า default ในโค้ด: https://api.khanoykorshabu.com/ctranbetweendate)
# PAID_BASE จะอนุมานจาก SALES_BASE อัตโนมัติ (เปลี่ยน ctranbetweendate -> cpaidbetweendate)
SALES_BASE=

# รีเฟรช cache "วันนี้ + ย้อนหลังกี่วัน" ตาม TTL กันข้อมูลค้างตอน POS sync ช้า (ค่า default = 3)
RECENT_REFRESH_DAYS=

# รหัสเมนูขายที่ตัดออกจากกฎ "วัตถุดิบห้ามนับเมนู (ที่)" (ชื่อในชีท BOM ไม่มี (ที่) แล้ว จึงระบุรหัสตรงๆ)
# ค่า default = 102001,180007 (สันคอหมูสไลด์)
EXCLUDE_PLATE_MENU_CODES=

# ---- ประวัติสแกนเข้า-ออก (ZKBio9 บน SQL Server) ----
# ต่อผ่าน localhost เพราะอยู่เครื่องเดียวกัน จึงไม่ต้องเปิดพอร์ต SQL ออกเน็ต
# แนะนำให้สร้าง login แยกที่อ่านได้อย่างเดียว ไม่ควรใช้ sa:
#   CREATE LOGIN narai_read WITH PASSWORD = '...';
#   USE ZKBio9; CREATE USER narai_read FOR LOGIN narai_read;
#   ALTER ROLE db_datareader ADD MEMBER narai_read;
# ถ้าเว้น ZK_DB_USER ไว้ เมนู "สแกนเข้า-ออก" จะขึ้นข้อความบอกว่ายังไม่ได้ตั้งค่า (ส่วนอื่นทำงานปกติ)
ZK_DB_HOST=localhost
ZK_DB_NAME=ZKBio9
ZK_DB_USER=
ZK_DB_PASSWORD=
# ใส่เมื่อ SQL Server เป็น named instance เช่น SQLEXPRESS (ปกติเว้นว่างได้)
ZK_DB_INSTANCE=
# ใส่เมื่อใช้พอร์ตอื่นที่ไม่ใช่ 1433
ZK_DB_PORT=

# ---- ตารางงาน (ฐานข้อมูล narai_hr บน SQL Server เครื่องเดียวกัน) ----
# /api/schedule บน Vercel ส่งคำสั่งมาที่ POST /schedule ของเครื่องนี้ แล้วเครื่องนี้ต่อ SQL Server ผ่าน localhost
# ที่ต้องอ้อมแบบนี้เพราะไฟร์วอลล์เปิดพอร์ต 1433 ให้เฉพาะ IP ในไทย ฟังก์ชันบน Vercel วิ่งมาจากต่างประเทศจึงต่อตรงไม่ได้
# ใช้ login เดียวกับที่สร้างไว้ให้เว็บ (narai_web) — ดูวิธีสร้างท้ายไฟล์ docs/schema-hr.sql
# ถ้าเว้น HR_DB_USER ไว้ หน้าลงตารางงานจะขึ้นข้อความบอกว่ายังไม่ได้ตั้งค่า (ส่วนอื่นทำงานปกติ)
HR_DB_HOST=localhost
HR_DB_NAME=narai_hr
HR_DB_USER=
HR_DB_PASSWORD=
# ใส่เมื่อ SQL Server เป็น named instance เช่น SQLEXPRESS (ปกติเว้นว่างได้)
HR_DB_INSTANCE=
# ใส่เมื่อใช้พอร์ตอื่นที่ไม่ใช่ 1433
HR_DB_PORT=

# --- หน้าล็อกอิน (ตาราง hr_user ในฐานข้อมูลเดียวกัน) ---
# ผู้ใช้ที่ยังไม่มีใน hr_user จะถูกไปถามชีท User เดิมให้ก่อน แล้วคัดลอกเข้าตารางพร้อมเข้ารหัสรหัสผ่าน
# เว้นว่าง = ใช้ URL ของ Apps Script เดิม (ค่าเริ่มต้นในโค้ด)
# ตั้งเป็น off เมื่อทุกสาขาล็อกอินครบแล้ว เพื่อตัดชีทออกจากเส้นทางล็อกอินถาวร
SHEET_LOGIN_URL=

# ---- หน้านับสต๊อก (ฐานข้อมูล InventoryNarai บนอินสแตนซ์เดียวกัน) ----
# คนละฐานข้อมูลกับตารางงาน แต่ใช้ host/login/พอร์ตชุดเดียวกันข้างบน
# login ที่ตั้งไว้ต้องมีสิทธิ์ในฐานข้อมูลนี้ด้วย (ดูส่วนให้สิทธิ์ท้ายไฟล์ docs/schema-stock.sql)
# เว้นว่างได้ = ใช้ InventoryNarai
STOCK_DB_NAME=InventoryNarai
