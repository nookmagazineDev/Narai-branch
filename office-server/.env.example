# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env จะไม่ถูก commit)
PORT=8787

# ฐานข้อมูล MySQL POS
DB_HOST=inventory.dyndns.tv
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ใส่รหัสผ่านตรงนี้

# โทเคนกันคนนอกยิง (ตั้งเป็นข้อความสุ่มยาวๆ) — ต้องตรงกับ USAGE_API_TOKEN ฝั่ง Vercel
# ถ้าเว้นว่าง = ไม่ตรวจ token (ใช้ตอนทดสอบเท่านั้น)
API_TOKEN=
