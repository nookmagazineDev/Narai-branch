# คัดลอกเป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ไม่ถูก commit)
PORT=8787

# ฐานข้อมูล MySQL POS
DB_HOST=inventory.dyndns.tv
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ใส่รหัสผ่านตรงนี้

# token กันคนนอก (ถ้าเว้นว่าง = ไม่ตรวจ) — ถ้าตั้ง ต้องใส่ USAGE_API_TOKEN ฝั่ง Vercel ให้ตรงกัน
API_TOKEN=

# ปิด UPnP อัตโนมัติได้โดยตั้งเป็น off (กรณี forward พอร์ตเองที่ router แล้ว)
UPNP=
